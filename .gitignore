# ============================================================================
# 火柴人联盟 (DiabloLOL) — 逆向重建 + 混合 Patch 工程
# ============================================================================

# ----------------------------------------------------------------- Gradle/IDE
.gradle/
build/
local.properties
local.properties.*
.idea/
*.iml
.DS_Store
captures/

# -------------------------------------------------- Android 产物与签名材料
*.apk
*.aab
*.ap_
*.idsig
*.keystore
*.jks
*.p12

# ------------------------------------------------------ 反编译/逆向中间产物
apktool_out/
ghidra-proj/
ghidra-scripts/
*.smali
*.gpr
*.rep

# ------------------------------------- NDK 编译中间件（源码入库，产物不入库）
obj/
libs/
.externalNativeBuild/
.cxx/
*.o
*.a

# ==================== 专有二进制：全部已入库，克隆即可构建 ====================
# 原生库：app/src/main/jniLibs/armeabi-v7a/*.so（16 个，约 13.5 MB）
# 游戏资源：app/src/main/assets/（约 103 MB，2519 个文件）
# 二者均已入库，此处仅排除重复备份与 strip 副本。
**/jniLibs/**/*.orig
**/jniLibs/**/*.bak
**/assets/**/*.orig
**/assets/**/*.bak

# -------------------------------------------------------------- 工作区临时件
TMP/
work/
*.log
*.bak
*.bak-*
*.orig
*.off
*.rej
*.patch.bak
screen*.png
# 只在仓库根目录排除打包/压缩件；assets 里的 *.zip 是游戏运行时资源，必须入库
/*.zip
/*.7z
/*.rar

# 逆向过程留下的原生库副本（源码在 cpp/，这里是编译产物/备份，不入库）
*.so.orig
*.so.bak
